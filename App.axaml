<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Avance_Player.Converters"
             x:Class="Avance_Player.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <converters:ArtworkColorConverter x:Key="ArtworkColorConverter" />
        <converters:LevelHeightConverter x:Key="LevelHeightConverter" />
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        <converters:CountToBoolConverter x:Key="CountToEmptyConverter" Invert="True" />
        <Color x:Key="SystemAccentColor">#C9B08A</Color>
        <Color x:Key="SystemAccentColorDark1">#B49B77</Color>
        <Color x:Key="SystemAccentColorDark2">#9E8765</Color>
        <Color x:Key="SystemAccentColorDark3">#887353</Color>
        <Color x:Key="SystemAccentColorLight1">#D8C3A3</Color>
        <Color x:Key="SystemAccentColorLight2">#E5D4B9</Color>
        <Color x:Key="SystemAccentColorLight3">#F1E4CE</Color>
        <SolidColorBrush x:Key="SystemAccentBrush" Color="{StaticResource SystemAccentColor}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
