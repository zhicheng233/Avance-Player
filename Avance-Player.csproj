<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <!-- Windows 构建要用 Windows TFM，SMTC 才能投影。Linux/macOS 继续用普通 net10.0，
    这样在非 Windows 机器上也能交叉发布。 -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- README 只是给仓库看的，别跟着图标一起打进 AvaloniaResource。 -->
        <AvaloniaResource Include="Assets/**" Exclude="Assets/README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="SharpHook" Version="5.3.9" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
        <PackageReference Include="TagLibSharp" Version="2.3.0" />
        <PackageReference Include="LibVLCSharp" Version="3.10.2" />
        <!-- Linux 用系统的 libvlc，其他桌面把原生运行时打进去。
        加 RuntimeIdentifier 判断是为了 Linux/CI 交叉发布时别乱拉包。 -->
        <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24"
                          Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or '$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-arm64'" />
        <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2"
                          Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))) Or '$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'" />
        <PackageReference Include="LibSMTC" Version="1.1.0"
                          Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
    </ItemGroup>
</Project>
