<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Avance_Player.ViewModels"
        xmlns:models="using:Avance_Player.Models"
        xmlns:converters="using:Avance_Player.Converters"
        mc:Ignorable="d"
        x:Class="Avance_Player.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Avance Player"
        Width="1360" Height="900" MinWidth="960" MinHeight="620"
        Background="#0B0B0E" Foreground="#F7F5F8"
        FontFamily="Inter">

    <Window.Resources>
        <converters:ArtworkColorConverter x:Key="ArtworkColorConverter" />
        <DataTemplate x:Key="SongRowTemplate" x:DataType="models:Music">
            <Border Classes="song-row" Padding="10,8" CornerRadius="12">
                <Grid ColumnDefinitions="34,48,*,Auto,Auto" ColumnSpacing="14">
                    <TextBlock Grid.Column="0" Text="♪" Foreground="#77747E" FontSize="15"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Border Grid.Column="1" Width="46" Height="46" CornerRadius="9" ClipToBounds="True">
                        <Grid>
                            <Border Background="{Binding ArtworkColor, Converter={StaticResource ArtworkColorConverter}}" />
                            <Border Background="#406985" Opacity="0.45" CornerRadius="30"
                                    Width="35" Height="35" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-9,0" />
                            <TextBlock Text="♫" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#9996A1"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Album}" FontSize="12" Foreground="#8E8B95"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Button Classes="row-action" Content="＋" ToolTip.Tip="Add to playlist"
                                Command="{Binding $parent[Window].DataContext.AddTrackToPlaylistCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="row-play" Content="▶" ToolTip.Tip="Play this song"
                                Command="{Binding $parent[Window].DataContext.PlayTrackCommand}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistTrackTemplate" x:DataType="models:Music">
            <Border Classes="song-row" Padding="10,8" CornerRadius="12">
                <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="9" Background="{Binding ArtworkColor, Converter={StaticResource ArtworkColorConverter}}">
                        <TextBlock Text="♪" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#9996A1" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" FontSize="12" Foreground="#8E8B95" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Button Classes="row-play" Content="▶" Command="{Binding $parent[Window].DataContext.PlayTrackCommand}" CommandParameter="{Binding}" />
                        <Button Classes="row-action" Content="−" ToolTip.Tip="Remove from playlist"
                                Command="{Binding $parent[Window].DataContext.RemoveTrackFromPlaylistCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LibraryPageViewModel}" x:DataType="vm:LibraryPageViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="42,34,42,44" Spacing="30">
                    <StackPanel Spacing="7">
                        <TextBlock Text="YOUR MUSIC, YOUR MOMENT" Foreground="#B7A5F0" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
                        <TextBlock Text="{Binding Title}" FontSize="38" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="#A6A3AD" FontSize="15" />
                    </StackPanel>

                    <Border CornerRadius="24" Padding="30" MinHeight="188" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#433477" Offset="0" />
                                <GradientStop Color="#25233A" Offset="0.55" />
                                <GradientStop Color="#182E35" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="12" VerticalAlignment="Center" MaxWidth="500">
                                <Border Background="#FFFFFF" Opacity="0.13" CornerRadius="20" Padding="10,5" HorizontalAlignment="Left">
                                    <TextBlock Text="A LITTLE SPACE TO BREATHE" FontSize="10" FontWeight="Bold" LetterSpacing="1.5" />
                                </Border>
                                <TextBlock Text="Find your&#10;own frequency." FontSize="30" FontWeight="Bold" LineHeight="34" />
                                <Button Classes="primary-button" Content="Go to now playing  →" HorizontalAlignment="Left"
                                        Command="{Binding $parent[Window].DataContext.OpenPlayerCommand}" />
                            </StackPanel>
                            <Grid Grid.Column="1" Width="190" Height="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="142" Height="142" Fill="#BD9DFF" Opacity="0.17" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                <Ellipse Width="112" Height="112" Fill="#7ED5D1" Opacity="0.18" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <Border Width="106" Height="106" CornerRadius="54" Background="#17151E" BorderBrush="#FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#B9A2F5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="In your rotation" FontSize="21" FontWeight="Bold" />
                                <TextBlock Text="A few good places to start." FontSize="12" Foreground="#8E8B95" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="TITLE                                      ALBUM" FontSize="10" Foreground="#77747E" VerticalAlignment="Bottom" Margin="0,0,44,2" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource SongRowTemplate}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TrackCollectionPageViewModel}" x:DataType="vm:TrackCollectionPageViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="42,38,42,48" Spacing="28">
                    <StackPanel Spacing="7">
                        <TextBlock Text="COLLECTION" Foreground="#B7A5F0" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
                        <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="#A6A3AD" FontSize="15" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource SongRowTemplate}" />
                    <TextBlock Text="Nothing here just yet." Foreground="#898690" IsVisible="{Binding IsEmpty}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CategoryBrowsePageViewModel}" x:DataType="vm:CategoryBrowsePageViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="42,38,42,48" Spacing="26">
                    <StackPanel Spacing="7">
                        <TextBlock Text="BROWSE YOUR LIBRARY" Foreground="#B7A5F0" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
                        <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="#A6A3AD" FontSize="15" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryGroupViewModel">
                                <Button Classes="category-card" Command="{Binding $parent[Window].DataContext.OpenCategoryGroupCommand}" CommandParameter="{Binding}">
                                    <Grid RowDefinitions="*,Auto" Width="190" Height="180">
                                        <Border Grid.RowSpan="2" CornerRadius="18" Background="#282333" ClipToBounds="True">
                                            <Grid>
                                                <Border Background="{Binding ArtworkColor, Converter={StaticResource ArtworkColorConverter}}" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Top" Width="140" Height="140" CornerRadius="75" Margin="0,-44,-26,0" />
                                                <Border Background="#182B32" Opacity="0.72" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="120" Height="120" CornerRadius="65" Margin="-34,0,0,-48" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="18,18,14,0" TextWrapping="Wrap" MaxLines="2" />
                                        <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="3">
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#D0CBD8" />
                                            <TextBlock Text="Open collection  →" FontSize="11" Foreground="#CBB9FF" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaylistsPageViewModel}" x:DataType="vm:PlaylistsPageViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="42,38,42,48" Spacing="26">
                    <StackPanel Spacing="7">
                        <TextBlock Text="MADE BY YOU" Foreground="#B7A5F0" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
                        <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="#A6A3AD" FontSize="15" />
                    </StackPanel>
                    <Border Background="#17171D" BorderBrush="#292830" BorderThickness="1" CornerRadius="17" Padding="15">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                             <TextBox PlaceholderText="Give this playlist a name" Text="{Binding $parent[Window].DataContext.NewPlaylistName, Mode=TwoWay}" />
                            <Button Grid.Column="1" Classes="primary-button" Content="＋  Create playlist"
                                    Command="{Binding $parent[Window].DataContext.CreatePlaylistCommand}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <Button Classes="playlist-card" Command="{Binding $parent[Window].DataContext.OpenPlaylistCommand}" CommandParameter="{Binding}">
                                    <StackPanel Width="205" Spacing="13">
                                        <Border Height="142" CornerRadius="14" ClipToBounds="True">
                                            <Grid>
                                                <Border Background="#382D55" />
                                                <Border Background="#335A5B" Opacity="0.8" Width="125" Height="125" CornerRadius="65" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-19,0" />
                                                <Border Background="#A879A9" Opacity="0.55" Width="100" Height="100" CornerRadius="55" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,-35" />
                                                <TextBlock Text="♫" FontSize="42" Foreground="#F2ECFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Spacing="4" Margin="2,0">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Tracks.Count}" FontSize="12" Foreground="#93909A" />
                                                <TextBlock Text="songs" FontSize="12" Foreground="#93909A" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No playlists yet — create one to start collecting." Foreground="#898690" IsVisible="{Binding IsEmpty}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaylistDetailPageViewModel}" x:DataType="vm:PlaylistDetailPageViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="42,38,42,48" Spacing="26">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                        <Border Width="174" Height="174" CornerRadius="22" ClipToBounds="True">
                            <Grid>
                                <Border Background="#382D55" />
                                <Border Background="#335A5B" Opacity="0.8" Width="130" Height="130" CornerRadius="70" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,-25,0" />
                                <TextBlock Text="♫" FontSize="54" Foreground="#F2ECFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="PLAYLIST" Foreground="#B7A5F0" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
                            <TextBox Text="{Binding Playlist.Name, Mode=TwoWay}" FontSize="30" FontWeight="Bold" Background="Transparent" BorderThickness="0" Padding="0" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding Playlist.Tracks.Count}" Foreground="#A6A3AD" FontSize="13" />
                            <TextBlock Text="songs · Your collection, your rules." Foreground="#A6A3AD" FontSize="13" />
                        </StackPanel>
                            <Button Classes="danger-button" Content="Delete playlist" HorizontalAlignment="Left"
                                    Command="{Binding $parent[Window].DataContext.DeletePlaylistCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12">
                        <TextBlock Text="In this playlist" FontSize="20" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding Playlist.Tracks}" ItemTemplate="{StaticResource PlaylistTrackTemplate}" />
                        <TextBlock Text="This playlist is still waiting for its first song." Foreground="#898690" IsVisible="{Binding IsEmpty}" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Add something good" FontSize="20" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding Library}" ItemTemplate="{StaticResource SongRowTemplate}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlayerPageViewModel}" x:DataType="vm:PlayerPageViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="650" ClipToBounds="True">
                    <Ellipse Width="520" Height="520" Fill="#7759B8" Opacity="{Binding $parent[Window].DataContext.AmbientOpacity}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-250,-150,0" />
                    <Ellipse Width="440" Height="440" Fill="#327C79" Opacity="{Binding $parent[Window].DataContext.AmbientOpacity}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-180,0,0,-220" />
                    <StackPanel Margin="42,32,42,44" Spacing="24">
                        <StackPanel Spacing="6">
                            <TextBlock Text="NOW PLAYING" Foreground="#C0A9FF" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
                            <TextBlock Text="Stay here for a while." FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="A little room for the song you're in." Foreground="#A6A3AD" FontSize="14" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="34" VerticalAlignment="Center">
                            <StackPanel Spacing="17" HorizontalAlignment="Center" MaxWidth="420">
                                <Border Width="290" Height="290" CornerRadius="24" ClipToBounds="True" BoxShadow="0 18 58 0 #70000000">
                                    <Grid>
                                        <Border Background="{Binding $parent[Window].DataContext.CurrentTrack.ArtworkColor, Converter={StaticResource ArtworkColorConverter}}" />
                                        <Ellipse Width="280" Height="280" Fill="#6FA9A2" Opacity="0.48" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-78,-82,0" />
                                        <Ellipse Width="245" Height="245" Fill="#DB907C" Opacity="0.55" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-56,0,0,-96" />
                                        <Border Width="116" Height="116" CornerRadius="60" Background="#15131A" BorderBrush="#FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="14" Background="#D5C8F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Spacing="5" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding $parent[Window].DataContext.CurrentTrack.Title}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding $parent[Window].DataContext.CurrentTrack.Artist}" FontSize="14" Foreground="#B9B5C1" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding $parent[Window].DataContext.CurrentTrack.Album}" FontSize="12" Foreground="#85818D" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Button Classes="transport-button" Content="|◀" Command="{Binding $parent[Window].DataContext.PreviousTrackCommand}" />
                                    <Button Classes="transport-main" Content="{Binding $parent[Window].DataContext.PlaybackGlyph}" Command="{Binding $parent[Window].DataContext.TogglePlaybackCommand}" />
                                    <Button Classes="transport-button" Content="▶|" Command="{Binding $parent[Window].DataContext.NextTrackCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="20" MaxWidth="470">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="THE WORDS" Foreground="#C0A9FF" FontSize="10" FontWeight="Bold" LetterSpacing="2" />
                                        <TextBlock Text="Sing along, softly." FontSize="22" FontWeight="Bold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="LYRICS" Foreground="#77747E" FontSize="10" VerticalAlignment="Bottom" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.CurrentTrack.Lyrics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LyricLine">
                                            <TextBlock Classes="lyric-line" Classes.current="{Binding IsCurrent}" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,13" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No synced lyrics for this track yet." Foreground="#8D8994"
                                           IsVisible="{Binding $parent[Window].DataContext.NoLyricsAvailable}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="ToggleButton.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9895A0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ToggleButton.nav-item:pointerover">
            <Setter Property="Background" Value="#1A1A21" />
            <Setter Property="Foreground" Value="#EDEAF3" />
        </Style>
        <Style Selector="ToggleButton.nav-item:checked">
            <Setter Property="Background" Value="#292432" />
            <Setter Property="Foreground" Value="#D5C5FF" />
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="#1A1A21" />
            <Setter Property="Foreground" Value="#EDEAF3" />
        </Style>
        <Style Selector="Button.primary-button">
            <Setter Property="Background" Value="#C6B2FF" />
            <Setter Property="Foreground" Value="#17131F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary-button:pointerover">
            <Setter Property="Background" Value="#D5C8FF" />
        </Style>
        <Style Selector="Button.danger-button">
            <Setter Property="Background" Value="#2D2027" />
            <Setter Property="Foreground" Value="#E6A7B6" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.row-action, Button.row-play">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="#222129" />
            <Setter Property="Foreground" Value="#D7D3DE" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.row-play:pointerover">
            <Setter Property="Background" Value="#C6B2FF" />
            <Setter Property="Foreground" Value="#17131F" />
        </Style>
        <Style Selector="Border.song-row:pointerover">
            <Setter Property="Background" Value="#19191F" />
        </Style>
        <Style Selector="Button.category-card, Button.playlist-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.category-card:pointerover, Button.playlist-card:pointerover">
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style Selector="Button.transport-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D9D5E0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.transport-main">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="#F1ECFA" />
            <Setter Property="Foreground" Value="#17131F" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.mini-transport">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAA6B2" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.mini-play">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#C6B2FF" />
            <Setter Property="Foreground" Value="#17131F" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.lyric-line">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#AAA6B2" />
            <Setter Property="Opacity" Value="0.52" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                    <DoubleTransition Property="FontSize" Duration="0:0:0.35" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.lyric-line.current">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="Foreground" Value="#F5F1FC" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="238,*" RowDefinitions="*,Auto">
        <Border Grid.RowSpan="2" Background="#111115" BorderBrush="#242329" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="17,20,17,17">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="8,2,0,26">
                    <Border Width="34" Height="34" CornerRadius="11" Background="#C6B2FF">
                        <TextBlock Text="a" FontSize="24" FontWeight="Bold" Foreground="#211A2D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="avance" FontSize="17" FontWeight="Bold" LetterSpacing="0.6" />
                        <TextBlock Text="MUSIC, IN MOTION" FontSize="8" Foreground="#898590" LetterSpacing="1.4" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="5">
                    <TextBlock Text="YOUR SPACE" FontSize="9" FontWeight="Bold" Foreground="#716E78" LetterSpacing="1.7" Margin="12,0,0,5" />
                    <ToggleButton Classes="nav-item" Content="♫    Library" IsChecked="{Binding IsLibrarySelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="library" />
                    <ToggleButton Classes="nav-item" Content="◉    Artists" IsChecked="{Binding IsArtistsSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="artists" />
                    <ToggleButton Classes="nav-item" Content="▤    Albums" IsChecked="{Binding IsAlbumsSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="albums" />
                    <ToggleButton Classes="nav-item" Content="◌    Genres" IsChecked="{Binding IsGenresSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="genres" />
                    <ToggleButton Classes="nav-item" Content="▣    Playlists" IsChecked="{Binding IsPlaylistsSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="playlists" />
                    <ToggleButton Classes="nav-item" Content="◷    Recently played" IsChecked="{Binding IsRecentSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="recent" />
                </StackPanel>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,27,7,9">
                    <TextBlock Text="YOUR PLAYLISTS" FontSize="9" FontWeight="Bold" Foreground="#716E78" LetterSpacing="1.5" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="＋" Classes="row-action" Width="25" Height="25" ToolTip.Tip="Create playlist"
                            Command="{Binding NavigateCommand}" CommandParameter="playlists" />
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <Button Classes="nav-item" Background="Transparent" Foreground="#96939D" BorderThickness="0"
                                        HorizontalContentAlignment="Left" Padding="12,9" CornerRadius="9"
                                        Command="{Binding $parent[Window].DataContext.OpenPlaylistCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="♫" Foreground="#A99BD1" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="4" Spacing="12" Margin="5,16,5,0">
                    <Border Background="#1A191F" CornerRadius="13" Padding="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="A note from Avance" FontSize="11" FontWeight="SemiBold" Foreground="#D8D1E8" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#8E8A96" TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="A QUIETER KIND OF PLAYER" FontSize="8" Foreground="#66636D" LetterSpacing="1.2" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Background="#0D0D11">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>

        <Border Grid.Column="1" Grid.Row="1" Background="#141419" BorderBrush="#292830" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="2*,3*,2*" ColumnSpacing="16">
                <Button Classes="now-playing-link" Background="Transparent" BorderThickness="0" Padding="0"
                        Command="{Binding OpenPlayerCommand}" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="47" Height="47" CornerRadius="9" Background="{Binding CurrentTrack.ArtworkColor, Converter={StaticResource ArtworkColorConverter}}">
                            <TextBlock Text="♫" FontSize="21" Foreground="#F2ECFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" VerticalAlignment="Center" MaxWidth="210">
                            <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentTrack.Artist}" FontSize="10" Foreground="#96929E" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="19" HorizontalAlignment="Center">
                        <Button Classes="mini-transport" Content="|◀" Command="{Binding PreviousTrackCommand}" />
                        <Button Classes="mini-play" Content="{Binding PlaybackGlyph}" Command="{Binding TogglePlaybackCommand}" />
                        <Button Classes="mini-transport" Content="▶|" Command="{Binding NextTrackCommand}" />
                        <Button Classes="mini-transport" Content="■" ToolTip.Tip="Stop" Command="{Binding StopCommand}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding CurrentTimeLabel}" FontSize="9" Foreground="#85818D" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding CurrentDurationSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" FontSize="9" Foreground="#85818D" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="♫" FontSize="14" Foreground="#AAA6B2" VerticalAlignment="Center" />
                    <TextBlock Text="Avance Player · UI preview" FontSize="10" Foreground="#77747E" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
